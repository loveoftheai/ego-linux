#!/usr/bin/env node
/**
 * ego-browser (Linux) — CLI launcher.
 *
 * Original re-implementation of the ego(lite) ego-browser CLI surface
 * (see ANALYSIS.md §1.3 for the interface spec recovered from the macOS binary).
 * Subcommands: help / skill / nodejs / import / upgrade.
 *
 * Node >= 22. Keep this file dependency-free (node:* only).
 */
import { createRequire } from "node:module";
import {
  cpSync,
  existsSync,
  mkdtempSync,
  readFileSync,
  rmSync,
  statSync,
  writeFileSync,
} from "node:fs";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";
import { homedir, tmpdir } from "node:os";
import { spawnSync } from "node:child_process";
import { refreshManagedEntrySkill, runFirstRun } from "./src/first-run.js";

const HERE = dirname(fileURLToPath(import.meta.url));
const require = createRequire(import.meta.url);

function readVersion() {
  try {
    return readFileSync(join(HERE, "VERSION"), "utf8").trim() || "0.0.0";
  } catch {
    return "0.0.0";
  }
}
const VERSION = readVersion();

function fail(message, code = 1) {
  process.stderr.write(`${message}\n`);
  process.exit(code);
}

function out(text) {
  try {
    process.stdout.write(text.endsWith("\n") ? text : `${text}\n`);
  } catch (err) {
    if (err && err.code === "EPIPE") process.exit(0);
    throw err;
  }
}
// A downstream `| head` closing the pipe must not crash the CLI.
process.stdout.on("error", (err) => {
  if (err && err.code === "EPIPE") process.exit(0);
  throw err;
});

